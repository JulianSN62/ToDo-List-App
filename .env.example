# =====================================================================
#  Variables de entorno de ToDo List
#  Copiá este archivo como `.env` y completá los valores.
#  El archivo `.env` está en el .gitignore: nunca se sube al repositorio.
#
#  IMPORTANTE: todas las variables que empiezan con VITE_ quedan
#  incluidas en el código que descarga el navegador o el celular.
#  Por eso acá SOLO van valores públicos. Nunca pongas acá:
#    - la "secret key" de Supabase (sb_secret_...) ni la service_role
#    - la contraseña de la base de datos
#    - la contraseña del rol powersync_role
#  El build se cancela automáticamente si detecta alguno de esos secretos.
# =====================================================================

# --- Supabase (Project Settings -> API Keys) ---
# URL del proyecto, por ejemplo https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=
# Publishable key (empieza con sb_publishable_). Es pública por diseño:
# la seguridad de los datos la garantizan las políticas RLS de la migración.
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- PowerSync (dashboard de PowerSync -> tu instancia -> Connect) ---
# URL de la instancia, por ejemplo https://xxxxxxxx.powersync.journeyapps.com
VITE_POWERSYNC_URL=

# --- Captcha del login (opcional, apagado si la clave queda vacía) ---
# Proveedor: turnstile | hcaptcha
VITE_CAPTCHA_PROVIDER=turnstile
# Site key pública del proveedor. Dejar vacía para desactivar el captcha.
# Si la completás, también hay que activar el captcha en Supabase
# (Authentication -> Attack Protection) con la secret key del proveedor.
VITE_CAPTCHA_SITE_KEY=

{
  "$schema": "Mis Tareas design tokens — mirror of tokens.css, kept in sync manually",
  "color": {
    "background": { "light": "#F8FAFC", "dark": "#0F172A" },
    "surface": { "light": "#FFFFFF", "dark": "#1E293B" },
    "border": { "light": "#E2E8F0", "dark": "#334155" },
    "textPrimary": { "light": "#0F172A", "dark": "#F1F5F9" },
    "textSecondary": { "light": "#64748B", "dark": "#94A3B8" },
    "accent": { "light": "#4F46E5", "dark": "#818CF8" },
    "accentContrast": { "light": "#FFFFFF", "dark": "#FFFFFF" },
    "semantic": {
      "overdue": { "light": "#EF4444", "dark": "#F87171" },
      "overdueBg": { "light": "#FEF2F2", "dark": "rgba(248,113,113,0.12)" },
      "priority": { "light": "#F59E0B", "dark": "#FBBF24" },
      "priorityBg": { "light": "#FFFBEB", "dark": "rgba(251,191,36,0.12)" },
      "completed": { "light": "#22C55E", "dark": "#4ADE80" },
      "completedBg": { "light": "#F0FDF4", "dark": "rgba(74,222,128,0.12)" }
    },
    "userTokens": {
      "slate": { "light": "#64748B", "dark": "#94A3B8" },
      "red": { "light": "#EF4444", "dark": "#F87171" },
      "orange": { "light": "#F97316", "dark": "#FB923C" },
      "amber": { "light": "#F59E0B", "dark": "#FBBF24" },
      "green": { "light": "#22C55E", "dark": "#4ADE80" },
      "teal": { "light": "#14B8A6", "dark": "#2DD4BF" },
      "blue": { "light": "#3B82F6", "dark": "#60A5FA" },
      "indigo": { "light": "#6366F1", "dark": "#818CF8" },
      "purple": { "light": "#A855F7", "dark": "#C084FC" },
      "pink": { "light": "#EC4899", "dark": "#F472B6" }
    }
  },
  "typography": {
    "fontFamily": "Inter, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "googleFontsImport": "https://fonts.google.com/specimen/Inter",
    "weights": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "scale": {
      "caption": { "size": 12, "lineHeight": 16, "weight": 400, "usage": "indicadores, metadatos, 'Se borra en N días'" },
      "bodySm": { "size": 14, "lineHeight": 20, "weight": 400, "usage": "chips, texto secundario, filas de settings" },
      "body": { "size": 16, "lineHeight": 24, "weight": 400, "usage": "título de tarea, texto principal" },
      "titleSm": { "size": 18, "lineHeight": 24, "weight": 600, "usage": "nombre de carpeta, encabezado de sección" },
      "titleMd": { "size": 20, "lineHeight": 28, "weight": 600, "usage": "título de pantalla (mobile)" },
      "titleLg": { "size": 24, "lineHeight": 32, "weight": 700, "usage": "título de página/panel (desktop)" }
    }
  },
  "spacing": { "1": 4, "2": 8, "3": 12, "4": 16, "6": 24, "8": 32, "12": 48 },
  "sizing": {
    "tapTargetMin": 48,
    "rowHeightTask": 56,
    "rowHeightFolder": 56,
    "heightBottomNav": 64,
    "heightFab": 56,
    "widthSidebar": 280,
    "widthSidebarCollapsed": 72,
    "widthDetailPanel": 400,
    "iconSizeRow": 20,
    "iconSizeNav": 24
  },
  "radius": { "sm": 8, "md": 12, "full": 9999 },
  "elevation": {
    "sm": "0 1px 2px rgba(15,23,42,0.08)",
    "md": "0 4px 16px rgba(15,23,42,0.12)",
    "lg": "0 8px 32px rgba(15,23,42,0.16)",
    "note": "Solo en overlays: bottom sheet, panel de detalle, dropdown, toast, modal. Nunca en filas/cards de lista."
  },
  "breakpoints": {
    "mobile": { "max": 767, "nav": "bottom-nav + FAB" },
    "sidebar": { "min": 768, "max": 1023, "nav": "sidebar colapsable" },
    "desktop": { "min": 1024, "nav": "layout de 3 columnas (árbol | lista | detalle)" }
  },
  "motion": {
    "durationFast": "120ms",
    "durationBase": "200ms",
    "easingStandard": "cubic-bezier(0.2, 0, 0, 1)",
    "reducedMotion": "respeta prefers-reduced-motion: reduce (duraciones a 0ms)"
  }
}

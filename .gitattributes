# Fin de línea LF en todo el proyecto (Prettier y las herramientas lo esperan).
# Evita que Git for Windows (core.autocrlf=true) convierta los archivos a CRLF.
* text=auto eol=lf

# Scripts de Windows: CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binarios: sin conversión ni diff de texto
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.jar binary
*.keystore binary
*.jks binary
*.wasm binary
